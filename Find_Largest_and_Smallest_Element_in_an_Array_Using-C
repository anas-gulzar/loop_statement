#include <stdio.h>

int main() {
    int n;
    printf("Enter Size of Array : ");
    scanf("%d", &n);
    if(n < 1 || n > 50){
    printf("Invalid Array Size!");
    return 0;
    }
    int num[50];
    printf("Enter Numbers one by one : ");
    for(int i=0; i<n; i++){
        scanf("%d", &num[i]);
    }
    int largest = num[0];
    int smallest = num[0];

    for(int i=1; i<n; i++){
        if(num[i] > largest){
            largest = num[i];
        }else if(num[i] < smallest){
            smallest = num[i];
        }
    }

    printf("Smallest Element : %d\nLargest Element %d", smallest, largest);
}
