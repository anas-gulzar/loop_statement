#include <stdio.h>
int main(){

    char word[50];
    int countv=0;
    int counts=0;
    int countc=0;

    printf("enter your word :");
    scanf("%s",word);

    for(int i=0; word[i]!='\0'; i++){
        if(word[i]=='a'|| word[i]=='e'||word[i]=='i'|| word[i]=='o'|| word[i]=='u'){
            countv=countv+1;
        }else if(word[i]== ' '){
            counts=counts+1;
        }else{
            countc=countc+1;
        }
    }

    printf("total vowel = %d\n",countv);
    printf("total consonent = %d\n", countc);
    printf("total space = %d\n",counts);
}
