#include <stdio.h>

int main() {
    int n;
    printf("enter size :");
    scanf("%d",&n);
    int num[30];
    printf("enter value one by one :");
    for(int i=0; i<n; i++){
        scanf("%d",&num[i]);
    }
    
    int first = num[0];

    for(int i=0; i<n-1; i++){
        num[i] = num[i + 1];
    }
    num[n-1] = first;

    printf("After Left Rotate Array by One Position : ");
    for(int i=0; i<n; i++){
        printf("%d",num[i]);
    }
}
