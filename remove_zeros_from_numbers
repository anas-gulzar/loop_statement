#include <stdio.h>

int main() {
    long long num ;
    printf("Enter numbers :");
    scanf("%lld",&num);
    long long result = 0;
    long long place = 1;

    while (num > 0) {
        int digit = num  % 10;

        if (digit != 0) {
            result = digit * place + result;
            place *= 10;
        }

        num /= 10;
    }
    printf("%lld",result);
    return 0;
}
