#include <stdio.h>
int main(){
    int n;
    printf("enter size :");
    scanf("%d",&n);

    char str[n];
    printf("enter your word :");
    scanf("%s",&str);

    //char str[] ;
    for(int i=0; i<n; i++){
        if(str[i]=='a'||str[i]=='e'||str[i]=='i'||str[i]=='o'||str[i]=='u'){
            printf("%c is vowel \n" ,str[i]);
        }else{
            printf("%c is not vowel \n", str[i]);
        }
    }
}
