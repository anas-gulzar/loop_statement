#include <stdio.h>

int main() {
    int n;
    printf("enter size :");
    scanf("%d",&n);
    int num[20];
    printf("enter numbers one by one:");
    for(int i=0; i<n-1; i++){
        scanf("%d",&num[i]);
    }
    int sum = 0;
    int expected;
    int missing;

    for(int i=0; i<n-1; i++){
        sum = sum + num[i];
        expected = n * (n+1) / 2 ;
        missing = expected - sum;
    }

    printf("missing number is : %d",missing);
}
