#include <stdio.h>
int main(){
    int num;
    printf("enter value :");
    scanf("%d",& num);

    for(int i=2; i<num; i++){
        if(num%i==0){
            printf("%d is not prime",num);
            break;
        }
        
        else{
            printf("%d is prime ",num);
            break;
        }
    }
}
