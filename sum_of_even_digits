#include <stdio.h>

int main() {
    int num;
    printf("enter numbers :");
    scanf("%d",&num);
    int digit = 0;
    int sum = 0;

    while(num>0){
        digit = num % 10;
        if(digit % 2 == 0){
            sum = sum + digit;
        }
        num = num/10;
    }
    printf("sum of even digits : %d",sum);
}
