#include <stdio.h>

int main() {
    int num = 1239;
    int digit;
    int largest = 0;
    int smallest = 9;
    int difference = 0;

    while(num>0){
        digit = num % 10 ;
        if(digit>largest){
            largest = digit;
        }
        
        if(digit < smallest){
            smallest = digit;
        }
        num = num /10;
    }
    difference = largest - smallest;

    printf("%d",difference);
}
