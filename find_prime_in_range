#include <stdio.h>

int primary(int num)
{
    if (num < 2)
        return 0;

    for (int i = 2; i < num; i++)
    {
        if (num % i == 0)
        {
            return 0;
        }
    }

    return 1;
}

int main()
{
    int num;

    printf("enter value : ");
    scanf("%d", &num);

    for (int i = 2; i <= num; i++)
    {
        if (primary(i))
        {
            printf("%d is prime\n", i);
        }
    }

    return 0;
}
