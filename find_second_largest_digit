#include <stdio.h>

int main() {
    int n;
    printf("enter size :");
    scanf("%d",&n);
    int num[30];
    printf("enter numbers :");
    for(int i=0; i<n; i++){
        scanf("%d",&num[i]);
    }
    int largest = -1;
    int second = -1;

    for(int i = 0; i < n; i++){
        if(num[i]>largest){
            second = largest;
            largest = num[i]; 
        }else if(num[i]<largest && num[i]>second){
            second = num[i];
        }
    }
    printf("second largest : %d \n largest : %d",second , largest);
}
